# Copy to .env, fill in, then `source .env`. The .env file is gitignored.
#
# Your Snowflake account identifier, e.g. ABCDEFG-XY12345 (Snowsight: account details).
export SNOWFLAKE_ACCOUNT=
# The user you registered the public key against.
export SNOWFLAKE_USER=
# Path to the PRIVATE key. Keep it outside this repo.
export SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/case_intel_rsa_key.p8

# Optional: only set these if you changed them in sql/00_setup.sql.
# export SNOWFLAKE_ROLE=CASE_INTEL_ROLE
# export SNOWFLAKE_DATABASE=CASE_INTEL
# export SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# export SNOWFLAKE_SCHEMA=ANALYTICS
